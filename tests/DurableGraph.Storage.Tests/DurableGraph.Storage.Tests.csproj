<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DurableGraph.Serialization\DurableGraph.Serialization.csproj" />
    <ProjectReference Include="..\..\src\DurableGraph.Storage\DurableGraph.Storage.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' != 'true'">
    <PackageReference Include="Atelia.Data" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.Primitives" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.Rbf" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.RbfSegmentStore" Version="$(StorageRbfSegmentStorePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' == 'true'">
    <ProjectReference Include="$(StorageSourceRoot)/src/Data/Data.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Primitives/Primitives.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Rbf/Rbf.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/RbfSegmentStore/RbfSegmentStore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
