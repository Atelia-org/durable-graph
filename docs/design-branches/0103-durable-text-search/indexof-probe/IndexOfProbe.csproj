<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TieredCompilation>false</TieredCompilation>
    <NuGetAudit>false</NuGetAudit>
    <ProductDll Condition="'$(ProductDll)' == ''">$(MSBuildThisFileDirectory)../../../../src/DurableGraph/bin/Release/net10.0/Atelia.DurableGraph.dll</ProductDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Atelia.DurableGraph" HintPath="$(ProductDll)" />
  </ItemGroup>
</Project>
