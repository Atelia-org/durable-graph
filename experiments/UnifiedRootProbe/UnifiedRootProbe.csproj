<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseStorageSources)' != 'true'">
    <PackageReference Include="Atelia.Rbf" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.EventJournal" Version="$(StoragePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' == 'true'">
    <ProjectReference Include="$(StorageSourceRoot)/src/Rbf/Rbf.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/EventJournal/EventJournal.csproj" />
  </ItemGroup>
</Project>
