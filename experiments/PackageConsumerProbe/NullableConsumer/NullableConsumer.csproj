<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <HistoryVersion Condition="'$(HistoryVersion)' == ''">1</HistoryVersion>
    <DefineConstants>$(DefineConstants);HISTORY_V$(HistoryVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Model.cs" />
    <PackageReference Include="Atelia.DurableGraph" Version="$(DurableGraphPackageVersion)" />
  </ItemGroup>
</Project>
