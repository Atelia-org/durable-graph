<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Atelia.RecordClassHost</AssemblyName>
    <WarningsAsErrors>$(WarningsAsErrors);CS0433;CS0436</WarningsAsErrors>
    <HistoryVersion Condition="'$(HistoryVersion)' == ''">1</HistoryVersion>
    <DefineConstants>$(DefineConstants);HISTORY_V$(HistoryVersion)</DefineConstants>
    <DurableGraphGenerateDefinitions>true</DurableGraphGenerateDefinitions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Atelia.DurableGraph" Version="$(DurableGraphPackageVersion)" />
    <PackageReference Include="Atelia.DurableGraph.Persistence" Version="$(DurableGraphPackageVersion)" />
    <PackageReference Include="Atelia.RecordClassFactsLibrary" Version="$(ModelPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ProbeArtifacts.cs" Link="ProbeArtifacts.cs" />
  </ItemGroup>
</Project>
