<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reuse the existing test friend, without exposing the experiment publicly. -->
    <AssemblyName>Atelia.DurableGraph.Persistence.Tests</AssemblyName>
    <DurableGraphGenerateDefinitions>true</DurableGraphGenerateDefinitions>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Model.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="Atelia.DurableGraph" Version="$(DurableGraphPackageVersion)" />
    <!-- The alias separates the package's employee definition aggregator from the host's generator output. -->
    <PackageReference Include="Atelia.DurableGraph.Persistence" Version="$(DurableGraphPackageVersion)" Aliases="persistence" />
  </ItemGroup>
</Project>
