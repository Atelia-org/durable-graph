<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <HistoryVersion Condition="'$(HistoryVersion)' == ''">1</HistoryVersion>
    <DefineConstants>$(DefineConstants);HISTORY_V$(HistoryVersion)</DefineConstants>
    <DefineConstants Condition="'$(ReadersOnly)' == 'true'">$(DefineConstants);READERS_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="World.cs" />
    <Compile Include="Legacy.V1.cs" Condition="'$(HistoryVersion)' == '1'" />
    <Compile Include="Legacy.V2.cs" Condition="'$(HistoryVersion)' == '2'" />
    <PackageReference Include="Atelia.DurableGraph" Version="$(DurableGraphPackageVersion)" />
  </ItemGroup>
</Project>
