<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>RegisteredLeaf.Fanout</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DurableGraphGenerateDefinitions>true</DurableGraphGenerateDefinitions>
    <GraphRoot Condition="'$(GraphRoot)' == ''">../../..</GraphRoot>
    <DefineConstants Condition="'$(RegisteredLeaf)' == 'true'">$(DefineConstants);REGISTERED_LEAF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="DurableGraphGenerateDefinitions"/>
    <ProjectReference Include="$(GraphRoot)/src/DurableGraph.Persistence/DurableGraph.Persistence.csproj"/>
    <ProjectReference Include="$(GraphRoot)/src/DurableGraph.Generator/DurableGraph.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="$(GraphRoot)/src/Text/Text.csproj" Condition="'$(RegisteredLeaf)' == 'true'"/>
  </ItemGroup>
</Project>
