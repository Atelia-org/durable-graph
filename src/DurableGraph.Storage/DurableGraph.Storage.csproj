<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Atelia.DurableGraph.Storage.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(UseStorageSources)' != 'true'">
    <PackageReference Include="Atelia.Binary" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.Data" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.Primitives" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.Rbf" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.FrameStore" Version="$(StoragePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' == 'true'">
    <ProjectReference Include="$(StorageSourceRoot)/src/Binary/Binary.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Data/Data.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Primitives/Primitives.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Rbf/Rbf.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/FrameStore/FrameStore.csproj" />
  </ItemGroup>

</Project>
