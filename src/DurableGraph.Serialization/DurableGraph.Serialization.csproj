<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseStorageSources)' != 'true'">
    <PackageReference Include="Atelia.Binary" Version="$(StoragePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' == 'true'">
    <ProjectReference Include="$(StorageSourceRoot)/src/Binary/Binary.csproj" />
  </ItemGroup>

</Project>
