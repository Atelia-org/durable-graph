<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Deliver facade documentation; documenting every public low-level member is outside this slice. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DurableGraph\DurableGraph.csproj" />
    <ProjectReference Include="..\DurableGraph.Storage\DurableGraph.Storage.csproj" />
    <ProjectReference Include="..\DurableGraph.Generator\DurableGraph.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' != 'true'">
    <PackageReference Include="Atelia.Binary" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.FrameStore" Version="$(StoragePackageVersion)" />
    <PackageReference Include="Atelia.VersionStore" Version="$(StoragePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseStorageSources)' == 'true'">
    <ProjectReference Include="$(StorageSourceRoot)/src/Binary/Binary.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/FrameStore/FrameStore.csproj" />
    <ProjectReference Include="$(StorageSourceRoot)/src/VersionStore/VersionStore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atelia.ListDeltaReplayProbe" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Atelia.DurableGraph.Persistence.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Atelia.DurableGraph.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
